        <url-pattern>/BuyCropServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ConfirmReceiveServlet</servlet-name>
        <servlet-class>controller.buyer.ConfirmReceiveServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ConfirmReceiveServlet</servlet-name>
        <url-pattern>/ConfirmReceiveServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CommunicationServlet</servlet-name>
        <servlet-class>controller.buyer.CommunicationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CommunicationServlet</servlet-name>
        <url-pattern>/CommunicationServlet</url-pattern>
    </servlet-mapping>

