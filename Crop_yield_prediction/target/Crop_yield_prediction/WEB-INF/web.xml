    <servlet-mapping>
        <servlet-name>BuyerChatServlet</servlet-name>
        <url-pattern>/BuyerChatServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>WeatherServlet</servlet-name>
        <servlet-class>controller.farmer.WeatherServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>WeatherServlet</servlet-name>
        <url-pattern>/WeatherServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BuyerLoginServlet</servlet-name>
        <servlet-class>controller.buyer.BuyerLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BuyerLoginServlet</servlet-name>
        <url-pattern>/BuyerLoginServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BuyerRegisterServlet</servlet-name>
