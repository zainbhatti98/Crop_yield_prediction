<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0"
         metadata-complete="true">

    <display-name>Crop Yield Prediction</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <servlet>
        <servlet-name>FarmerLoginServlet</servlet-name>
        <servlet-class>controller.farmer.FarmerLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FarmerLoginServlet</servlet-name>
        <url-pattern>/FarmerLoginServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FarmerRegisterServlet</servlet-name>
        <servlet-class>controller.farmer.FarmerRegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FarmerRegisterServlet</servlet-name>
        <url-pattern>/FarmerRegisterServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SellCropServlet</servlet-name>
        <servlet-class>controller.farmer.SellCropServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SellCropServlet</servlet-name>
        <url-pattern>/SellCropServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>OrderStatusServlet</servlet-name>
        <servlet-class>controller.farmer.OrderStatusServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OrderStatusServlet</servlet-name>
        <url-pattern>/OrderStatusServlet</url-pattern>
    </servlet-mapping>

    <servlet>
