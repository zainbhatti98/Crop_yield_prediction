        <servlet-name>ApproveRequestServlet</servlet-name>
        <servlet-class>controller.admin.ApproveRequestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApproveRequestServlet</servlet-name>
        <url-pattern>/ApproveRequestServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RateFarmerServlet</servlet-name>
        <servlet-class>controller.admin.RateFarmerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RateFarmerServlet</servlet-name>
        <url-pattern>/RateFarmerServlet</url-pattern>
    </servlet-mapping>

</web-app>
